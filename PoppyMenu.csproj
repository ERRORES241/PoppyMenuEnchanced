<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>PoppyMenuEnchanced</AssemblyName>
    <Product>PoppyMenuEnchanced</Product>
    <Version>2.6</Version>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <RootNamespace>PoppyMenu</RootNamespace>

    <BepInExPluginGuid>com.poppy.poppymenuenchanced</BepInExPluginGuid>
    <BepInExPluginName>PoppyMenuEnchanced</BepInExPluginName>
    <BepInExPluginVersion>$(Version)</BepInExPluginVersion>

    <NoWarn>$(NoWarn);CS0436;CS0618;CS0612;NU1701;MSB3277</NoWarn>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.1.0" />
    <PackageReference Include="RiskOfRain2.GameLibs" Version="1.4.1-r.0" />
    <PackageReference Include="R2API.Core" Version="5.3.0" />
    <PackageReference Include="R2API.Networking" Version="1.0.4" />
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" IncludeAssets="compile" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tools/**/*.cs" />
    <Compile Remove="src/**/*.cs" />
  </ItemGroup>

  <Target Name="PackageMod" AfterTargets="Build">
    <PropertyGroup>
      <AuthorName>ERRORESSS</AuthorName>
      <ZipFileName>$(AuthorName)-$(AssemblyName)-$(Version).zip</ZipFileName>
      <DistDir>$(ProjectDir)dist\</DistDir>
      <StagingDir>$(DistDir)staging\</StagingDir>
    </PropertyGroup>

    <MakeDir Directories="$(DistDir);$(StagingDir)" />

    <Copy SourceFiles="manifest.json;icon.png;README.md;CHANGELOG.md;LICENSE;$(TargetPath)" DestinationFolder="$(StagingDir)" SkipUnchangedFiles="false" />

    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;Compress-Archive -Path '$(StagingDir)*' -DestinationPath '$(DistDir)$(ZipFileName)' -Force&quot;" />
    <RemoveDir Directories="$(StagingDir)" />

    <Message Text="[BUILD] Packaged mod ZIP for r2modmanager: $(DistDir)$(ZipFileName)" Importance="high" />
  </Target>

</Project>
